# 🏆 OpEx Platform - Production-Ready Configuration
# ================================================

# 🔐 Security Configuration
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS="http://localhost:3000"
CORS_CREDENTIALS=true
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="*"

# 🚦 Rate Limiting & Security Headers (Enterprise Defense)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY="default-src 'self'"
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# 🌐 Service URLs (Internal Docker Network)
AUTH_SERVICE_URL=http://auth-service:8000
ORCHESTRATION_SERVICE_URL=http://orchestration-service:8000  
METADATA_SERVICE_URL=http://metadata-service:8000
KONG_ADMIN_URL=http://kong:8001

# 🌐 Public URLs (External Access)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_ORCHESTRATION_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_METADATA_SERVICE_URL=http://localhost:8007

# 📊 Database Configuration  
POSTGRES_VERSION=15-alpine
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# 📊 Advanced Database Configuration (Martin Fowler's Enterprise Patterns)
DB_POOL_PRE_PING=true
DB_POOL_RESET_ON_RETURN=commit
DB_ECHO_SQL=false
DB_QUERY_TIMEOUT=30
DB_CONNECTION_MAX_AGE=3600
DB_HEALTH_CHECK_INTERVAL=60

# 📨 Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_AUTO_COMMIT_INTERVAL_MS=1000

# ⚡ Redis Configuration  
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_KEEPALIVE=true

# 🛡️ Circuit Breaker & Resilience (Martin Fowler's Reliability Patterns)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=1
RETRY_BACKOFF_MAX=30
BULKHEAD_MAX_CONCURRENT_CALLS=100

# � Observability Configuration
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLING_RATE=0.1
TRACE_ENABLED=true

# 🏥 Health Check Configuration (Enterprise Standards)
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=30
DEEP_HEALTH_CHECK_ENABLED=true
DEPENDENCY_CHECK_TIMEOUT=10
READINESS_CHECK_GRACE_PERIOD=60

# 📊 Monitoring & Alerting (Future-Ready Observability)
METRICS_ENABLED=true
METRICS_PUSH_INTERVAL=15
PROMETHEUS_GATEWAY_URL=http://prometheus:9091
ALERT_MANAGER_URL=http://alertmanager:9093
LOG_LEVEL=INFO
LOG_FORMAT=json
PERFORMANCE_MONITORING_ENABLED=true
ERROR_TRACKING_ENABLED=true
CUSTOM_METRICS_ENABLED=true
DASHBOARD_REFRESH_RATE=30

# ⚡ Performance & Resource Management (Donald Knuth Optimization)
MAX_WORKERS=4
WORKER_TIMEOUT=30
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=50
MEMORY_LIMIT=512m
CPU_LIMIT=0.5
ASYNC_POOL_SIZE=10
CACHE_TTL=300
CACHE_MAX_SIZE=1000
COMPRESSION_ENABLED=true
GZIP_MIN_SIZE=1000

# 📋 Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=JSON
PYTHONPATH=/app/src

# 🔧 Performance Configuration  
UVICORN_WORKERS=1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=false

# 🌍 Environment
ENVIRONMENT=development
DEBUG=false
TESTING=false

# 📦 Node.js Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
